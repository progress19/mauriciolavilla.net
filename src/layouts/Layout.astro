    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CWJ8KS2Y72');
    </script>
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content="Mauricio Lavilla - Desarrollador Full Stack especializado en JavaScript, Python, React, Node.js y Laravel. Desarrollo sitios web, e-commerce, sistemas de reservas y soluciones de IA. Experto en WordPress, DevOps y cloud computing." />
    <meta name="keywords" content="desarrollador full stack, programador javascript, desarrollador python, react developer, node.js, laravel, wordpress, e-commerce, tienda online, sistema de reservas, inteligencia artificial, chatbots, devops, aws, google cloud, desarrollador web, sitios web corporativos, landing pages, seo técnico, bases de datos mysql, postgresql, api rest, desarrollo frontend, backend, mauricio lavilla" />
    <meta name="author" content="Mauricio Lavilla" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="Spanish" />
    <meta name="geo.region" content="AR" />
    <meta name="geo.country" content="Argentina" />
    
    <!-- Open Graph / Facebook -->
