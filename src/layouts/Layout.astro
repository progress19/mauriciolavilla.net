---
import ScrollToTop from "../components/scrollToTop.astro";
import { translations } from "../translations.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Datos estructurados para SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Mauricio Lavilla",
  "jobTitle": "Desarrollador Full Stack",
  "description": "Desarrollador Full Stack especializado en JavaScript, Python, React, Node.js y Laravel. Experto en desarrollo web, e-commerce, inteligencia artificial y DevOps.",
  "url": "https://mauriciolavilla.net",
  "sameAs": [
    "https://github.com/progress19",
    "https://www.linkedin.com/in/mauriciolavilla/"
  ],
  "knowsAbout": [
    "Desarrollo Web Full Stack",
    "JavaScript",
    "Python",
    "React",
    "Node.js",
    "Laravel",
    "WordPress",
    "E-commerce",
    "Inteligencia Artificial",
    "DevOps",
    "AWS",
    "Google Cloud"
  ],
  "offers": {
    "@type": "Service",
    "serviceType": "Desarrollo de Software",
    "description": "Desarrollo de aplicaciones web, sitios web corporativos, e-commerce, sistemas de reservas y soluciones de inteligencia artificial"
  }
};
---

