    <meta property="og:url" content="https://mauriciolavilla.net/" />
    <meta property="og:title" content="Mauricio Lavilla - Desarrollador Full Stack | JavaScript, Python, React, Laravel" />
    <meta property="og:description" content="Desarrollo sitios web profesionales, e-commerce, sistemas de reservas y soluciones de inteligencia artificial. Especialista en React, Node.js, Laravel y DevOps." />
    <meta property="og:image" content="https://mauriciolavilla.net/og-image.jpg" />
