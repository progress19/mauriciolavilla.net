---
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

// SEO y metadatos específicos para RecFis
const seoData = {
  title: "RecFis v3 - Sistema de Gestión para Recaudadores Fiscales | Software ATM",
  description: "Sistema web profesional para recaudadores fiscales de Mendoza. Automatiza boletas ATM, gestión de honorarios, informes contables y partes oficiales. Versiones Standard y Full disponibles.",
  keywords: "recaudadores fiscales mendoza, sistema atm, boletas atm, recaudación judicial, software fiscal mendoza, gestión tributaria, honorarios fiscales, partes atm, recfis, sistema recaudación",
  url: "https://mauriciolavilla.net/recfis",
  image: "https://mauriciolavilla.net/og-recfis.jpg"
};

// Datos estructurados para SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "RecFis v3",
  "applicationCategory": "BusinessApplication",
  "description": "Sistema web integral para recaudadores fiscales de Mendoza. Automatiza la gestión de boletas ATM, control de honorarios, generación de informes y partes oficiales.",
  "offers": [
    {
      "@type": "Offer",
      "name": "RecFis Standard",
      "description": "Gestión completa de boletas ATM con funcionalidades esenciales para estudios pequeños y medianos",
      "category": "Software de Gestión Fiscal"
    },
    {
      "@type": "Offer", 
      "name": "RecFis Full",
      "description": "Versión completa con procesamiento automático de PDF, integración bancaria y contabilidad avanzada",
      "category": "Software de Gestión Fiscal"
    }
  ],
  "provider": {
    "@type": "Organization",
    "name": "Mauricio Lavilla",
    "url": "https://mauriciolavilla.net",
    "sameAs": [
      "https://github.com/progress19",
      "https://www.linkedin.com/in/mauriciolavilla/"
    ]
  },
  "operatingSystem": "Web Browser",
  "softwareRequirements": "Navegador web moderno",
  "featureList": [
    "Gestión de boletas ATM",
    "Control automático de honorarios",
    "Generación de partes oficiales",
    "Informes y reportes filtrables",
    "ABM de etapas y juzgados",
    "Procesamiento automático de PDF",
    "Integración bancaria",
    "Informes contables exportables"
  ],
  "targetAudience": {
    "@type": "Audience",
    "audienceType": "Recaudadores Fiscales, Estudios Jurídicos, Profesionales del Derecho"
  },
  "geographicArea": {
    "@type": "Place",
    "name": "Mendoza, Argentina"
  }
};
---

<Layout title={seoData.title}>
  <!-- Metadatos SEO específicos -->
  <head slot="head">
    <meta name="description" content={seoData.description} />
    <meta name="keywords" content={seoData.keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={seoData.url} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seoData.url} />
    <meta property="og:title" content={seoData.title} />
    <meta property="og:description" content={seoData.description} />
    <meta property="og:image" content={seoData.image} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="RecFis v3 - Sistema para Recaudadores Fiscales" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={seoData.url} />
    <meta property="twitter:title" content={seoData.title} />
    <meta property="twitter:description" content={seoData.description} />
    <meta property="twitter:image" content={seoData.image} />
    
    <!-- Geolocalización -->
    <meta name="geo.region" content="AR-M" />
    <meta name="geo.placename" content="Mendoza" />
    <meta name="geo.position" content="-32.8895;-68.8458" />
    <meta name="ICBM" content="-32.8895, -68.8458" />
    
    <!-- Datos estructurados JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <!-- Componente de cambio de tema con tema claro por defecto -->
  <ThemeToggle defaultTheme="light" />

  <!-- Navegación simple para volver al portfolio -->
  <div class="fixed top-4 left-4 z-50">
    <a 
      href="/" 
      class="inline-flex items-center justify-center w-12 h-12 bg-[var(--card-bg)]/80 backdrop-blur-md border border-[var(--border-color)] rounded-full text-[var(--white)] hover:text-[var(--sec)] hover:bg-[var(--card-bg)] transition-all duration-300 shadow-lg group"
      title="Volver al Portfolio"
      aria-label="Volver al Portfolio"
    >
      &lt;/&gt;
    </a>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    {/* Modern Hero Section */}
    <section class="flex flex-col justify-center items-center text-center pt-16 pb-24 relative overflow-hidden">
      {/* Background Elements */}
      <div class="absolute inset-0 overflow-hidden">
        <div class="hero-gradient"></div>
        <div class="floating-elements">
          <div class="float-element float-1"></div>
          <div class="float-element float-2"></div>
          <div class="float-element float-3"></div>
        </div>
      </div>
      
      {/* Content */}
      <div class="relative z-10">
        <div class="hero-badge">
          <span class="badge-icon">🚀</span>
          <span>Versión 3.0 - Nueva generación</span>
        </div>
        
        <h1 class="hero-title">
          <span class="hero-brand">RecFis v3</span>
          <span class="hero-subtitle">Sistema Integral para Recaudadores Fiscales</span>
        </h1>
        
        <p class="hero-description">
          <strong>Software especializado</strong> para <em>recaudadores fiscales de Mendoza</em>. 
          Automatiza la gestión de <strong>boletas ATM</strong>, <em>control de honorarios</em> 
          y <strong>partes oficiales</strong> con máxima eficiencia y seguridad garantizada.
        </p>
        
        <div class="hero-actions">
          <a href="#contacto" class="cta-primary-hero">
            <span>Solicitar Demo Gratuita</span>
            <svg class="cta-arrow" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
          <button class="cta-secondary-hero" onclick="document.getElementById('funcionalidades').scrollIntoView({behavior: 'smooth'})">
            Ver Funcionalidades
          </button>
        </div>
        
        {/* Trust Indicators */}
        <div class="trust-indicators">
          <div class="trust-item">
            <span class="trust-icon">⚡</span>
            <span>Implementación 48hs</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">🔒</span>
            <span>Seguridad Garantizada</span>
          </div>
          <div class="trust-item">
            <span class="trust-icon">📊</span>
            <span>ATM Compatible</span>
          </div>
        </div>
      </div>
    </section>

    {/* Modern Value Proposition */}
    <section class="py-3">
      <div class="modern-card value-prop-card">
        <div class="card-glow"></div>
        <div class="relative z-10">
          <h2 class="section-title-large text-center mb-8">
            ¿Qué es RecFis? Sistema de Gestión Fiscal Profesional
          </h2>
          <p class="value-prop-text">
            <strong>RecFis v3</strong> es el <span class="highlight-text">sistema líder</span> para <em>estudios jurídicos</em> y <strong>recaudadores fiscales en Mendoza</strong>. Especializado en <em>boletas de deuda ATM</em>, transforma procesos manuales en <span class="highlight-text">automatización inteligente</span>, garantizando precisión en <strong>honorarios fiscales</strong>, <em>gestión tributaria</em> y <strong>recaudación judicial</strong> en cada etapa del proceso.
          </p>
          
          {/* Key Metrics */}
          <div class="metrics-grid">
            <div class="metric-item">
              <div class="metric-number">+50</div>
              <div class="metric-label">Estudios Jurídicos</div>
            </div>
            <div class="metric-item">
              <div class="metric-number">98%</div>
              <div class="metric-label">Eficiencia Mejorada</div>
            </div>
            <div class="metric-item">
              <div class="metric-number">24/7</div>
              <div class="metric-label">Soporte Técnico</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Sección de keywords locales */}
    <section class="py-2">
      <div class="text-center">
        <h3 class="text-xl font-semibold text-[var(--sec)] mb-4">
          Solución Integral para Profesionales del Derecho en Mendoza
        </h3>
        <p class="text-[var(--white)] text-sm max-w-5xl mx-auto leading-relaxed">
          Diseñado específicamente para <em>abogados</em>, <strong>procuradores fiscales</strong>, <em>estudios jurídicos</em> y <strong>oficinas de recaudación</strong> que trabajan con la <em>Administración Tributaria de Mendoza (ATM)</em>. Compatible con todos los <strong>juzgados de Mendoza</strong> y <em>circunscripciones judiciales</em>.
        </p>
      </div>
    </section>
  </div>

  {/* Sistema de Importación Masiva ATM */}
  <section id="importacion-masiva" class="relative py-4">
    <div class="max-w-6xl mx-auto px-4">
      <div class="import-section-card">
        <div class="import-glow"></div>
        
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
          {/* Content */}
          <div class="space-y-6">
            <div class="space-y-4">
              <div class="flex items-center gap-3">
                <span class="version-badge">
                  <span class="badge-dot"></span>
                  Nuevo en v1.2.0
                </span>
              </div>
              
              <h3 class="import-title">
                Sistema de Importación Masiva ATM
              </h3>
              
              <p class="import-description">
                <strong>Ahorra cientos de horas</strong> de trabajo manual. Procesa miles de boletas desde Excel con validación automática, 
                configuración flexible y <span class="highlight">trazabilidad completa</span> de cada operación.
              </p>
            </div>

            {/* Key Features */}
            <div class="features-list">
              <div class="feature-item">
                <div class="feature-icon">📂</div>
                <div>
                  <h4 class="feature-title">Importación Inteligente</h4>
                  <p class="feature-desc">Filtrado automático de filas vacías y mapeo de campos desde Excel</p>
                </div>
              </div>
              
              <div class="feature-item">
                <div class="feature-icon">⚙️</div>
                <div>
                  <h4 class="feature-title">Configuración Flexible</h4>
                  <p class="feature-desc">Oficial, impuesto y etapa opcionales según tus necesidades</p>
                </div>
              </div>
              
              <div class="feature-item">
                <div class="feature-icon">🔄</div>
                <div>
                  <h4 class="feature-title">Sistema de Reversión</h4>
                  <p class="feature-desc">Auditoría completa con posibilidad de revertir importaciones</p>
                </div>
              </div>
            </div>

            {/* Value Proposition */}
            <div class="value-box">
              <div class="value-icon">💡</div>
              <div>
                <p class="value-text">
                  <strong>De horas a segundos:</strong> Lo que antes te tomaba días de trabajo manual, 
                  ahora lo resolvés en minutos con total seguridad y control.
                </p>
              </div>
            </div>

            <div class="import-actions">
              <a href="#contacto" class="btn-primary">
                <span>Solicitar Demo</span>
                <svg class="btn-arrow" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </div>

          {/* Visual Demo */}
          <div class="import-visual">
            <div class="upload-area">
              <div class="upload-icon">📄</div>
              <div class="upload-text">
                <h4>Arrastrá tu archivo Excel</h4>
                <p>.xlsx, .xls • hasta 10MB</p>
              </div>
              <div class="upload-arrow">↓</div>
            </div>
            
            <div class="process-flow">
              <div class="flow-step active">
                <div class="step-icon">✓</div>
                <span>Validación automática</span>
              </div>
              <div class="flow-step active">
                <div class="step-icon">✓</div>  
                <span>Mapeo de campos</span>
              </div>
              <div class="flow-step processing">
                <div class="step-icon pulse">⚡</div>
                <span>Creando boletas...</span>
              </div>
            </div>
            
            <div class="result-preview">
              <div class="result-stats">
                <div class="stat success">
                  <span class="stat-number">1,247</span>
                  <span class="stat-label">Procesadas</span>
                </div>
                <div class="stat pending">
                  <span class="stat-number">12</span>
                  <span class="stat-label">Errores</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* Modern Features Section */}
  <section id="funcionalidades" class="features-section py-6">
    <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
      <div class="features-header">
        <h3 class="section-title-xl">
          Software Completo para Recaudación Fiscal en Mendoza
        </h3>
        <p class="section-description-large">
          Todas las herramientas especializadas que necesitás para <strong>gestionar boletas ATM</strong>, 
          <em>honorarios fiscales</em> y <strong>recaudación judicial</strong> de manera profesional
        </p>
      </div>
      
      <div class="versions-comparison">
        {/* Version Standard */}
        <div class="version-card standard-card">
          <div class="version-header">
            <div class="version-badge standard">
              <span class="badge-icon">🗺️</span>
              <span>Standard</span>
            </div>
            <h4 class="version-title">RecFis Standard</h4>
            <p class="version-subtitle">Gestión Básica ATM - Ideal para estudios pequeños</p>
          </div>
          
          <div class="features-list">
            <div class="feature-item">
              <div class="feature-icon boletas">📋</div>
              <div class="feature-content">
                <h5 class="feature-name">Gestión de Boletas ATM</h5>
                <p class="feature-desc">Administración completa con etapas procesales, fechas de vencimiento e importes actualizados</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon honorarios">💰</div>
              <div class="feature-content">
                <h5 class="feature-name">Control de Honorarios Fiscales</h5>
                <p class="feature-desc">Cálculo automático de honorarios profesionales y sumas presupuestadas según aranceles</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon consulta">🔍</div>
              <div class="feature-content">
                <h5 class="feature-name">Consulta Judicial Avanzada</h5>
                <p class="feature-desc">Interfaz con filtros por juzgado, circunscripción, estado procesal y fechas</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon informes">📊</div>
              <div class="feature-content">
                <h5 class="feature-name">Informes de Recaudación</h5>
                <p class="feature-desc">Reportes detallados filtrables por períodos, montos recaudados y circunscripción judicial</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon partes">📧</div>
              <div class="feature-content">
                <h5 class="feature-name">Partes Oficiales ATM</h5>
                <p class="feature-desc">Generación automática en formato oficial (.txt) y envío directo por email a ATM</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon admin">⚙️</div>
              <div class="feature-content">
                <h5 class="feature-name">Administración Judicial</h5>
                <p class="feature-desc">ABM completo de etapas procesales, juzgados, oficiales de justicia y usuarios del sistema</p>
              </div>
            </div>
          </div>
        </div>

        {/* Version Full - Featured */}
        <div class="version-card full-card featured">
          <div class="version-header">
            <div class="version-badge full">
              <span class="badge-icon">🚀</span>
              <span>Full</span>
            </div>
            <div class="recommended-badge">
              <span>✨</span>
              <span>Recomendada</span>
            </div>
            <h4 class="version-title">RecFis Full</h4>
            <p class="version-subtitle">Automatización Completa - Para estudios de alto volumen</p>
            <div class="included-notice">Incluye todas las funciones Standard +</div>
          </div>
          
          <div class="features-list">
            <div class="feature-item premium">
              <div class="feature-icon ai">🤖</div>
              <div class="feature-content">
                <h5 class="feature-name">Procesamiento Automático PDF</h5>
                <p class="feature-desc">Ingreso masivo y automático de boletas liquidadas desde archivos PDF de ATM</p>
              </div>
              <div class="premium-indicator">IA</div>
            </div>
            <div class="feature-item premium">
              <div class="feature-icon banking">🏦</div>
              <div class="feature-content">
                <h5 class="feature-name">Integración Bancaria Mendoza</h5>
                <p class="feature-desc">Carga automática de pagos desde Banco Supervielle y Banco Nación sucursales Mendoza</p>
              </div>
              <div class="premium-indicator">API</div>
            </div>
            <div class="feature-item premium">
              <div class="feature-icon reports">📈</div>
              <div class="feature-content">
                <h5 class="feature-name">Contabilidad Fiscal Avanzada</h5>
                <p class="feature-desc">Informes contables exportables a Excel con filtros por fechas, bancos y circunscripciones</p>
              </div>
              <div class="premium-indicator">PRO</div>
            </div>
          </div>
          
          <div class="cta-container">
            <a href="#contacto" class="version-cta">
              <span>Solicitar Full</span>
              <svg class="cta-arrow" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {/* Experiencia */}
        <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-4 md:p-6 text-center">
          <span class="text-3xl mb-3 block">📱</span>
          <h5 class="text-[var(--sec)] font-semibold mb-2">Experiencia de Usuario Profesional</h5>
          <p class="text-[var(--white)] text-sm">Sistema 100% responsive para escritorio y móvil, modo claro/oscuro, backups automáticos diarios</p>
        </div>
        
        {/* Seguridad */}
        <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-4 md:p-6 text-center">
          <span class="text-3xl mb-3 block">🔒</span>
          <h5 class="text-[var(--sec)] font-semibold mb-2">Seguridad Jurídica Garantizada</h5>
          <p class="text-[var(--white)] text-sm">Certificado SSL, control de acceso por roles profesionales, código fuente y base de datos incluidos</p>
        </div>
        
        {/* Tecnología */}
        <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-4 md:p-6 text-center">
          <span class="text-3xl mb-3 block">⚡</span>
          <h5 class="text-[var(--sec)] font-semibold mb-2">Tecnología Empresarial</h5>
          <p class="text-[var(--white)] text-sm">Framework Laravel PHP + MySQL, hosting premium incluido y soporte técnico especializado</p>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-2 md:px-4">
    {/* Beneficios y Servicios Incluidos */}
    <section class="py-4">
      <div class="bg-gradient-to-r from-[var(--card-bg)] to-[var(--card-bg-alt)] rounded-2xl p-4 md:p-8 shadow-xl text-center border border-[var(--border-color)]">
        <h3 class="text-2xl md:text-3xl font-bold text-[var(--sec)] mb-6">
          Servicio Integral para Estudios Jurídicos en Mendoza
        </h3>
        <div class="grid md:grid-cols-3 gap-6 text-[var(--white)]">
          <div class="flex flex-col items-center">
            <span class="text-4xl mb-3">🌐</span>
            <h4 class="font-semibold mb-2">Hosting Premium Mendoza</h4>
            <p class="text-sm">6 meses bonificados + dominio .com.ar incluido, servidores en Argentina</p>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-4xl mb-3">⚡</span>
            <h4 class="font-semibold mb-2">Implementación Express</h4>
            <p class="text-sm">Instalación completa y capacitación del equipo en 48 horas</p>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-4xl mb-3">🛠️</span>
            <h4 class="font-semibold mb-2">Soporte Especializado ATM</h4>
            <p class="text-sm">Asistencia técnica especializada en normativas fiscales de Mendoza</p>
          </div>
        </div>
      </div>
    </section>

    {/* Sección de SEO local */}
    <section class="py-3">
      <div class="text-center">
        <h4 class="text-lg font-semibold text-[var(--sec)] mb-4">
          Especialistas en Recaudación Fiscal - Mendoza
        </h4>
        <p class="text-[var(--white)] text-sm max-w-4xl mx-auto leading-relaxed mb-6">
          <strong>RecFis v3</strong> es el <em>software líder</em> para la <strong>automatización de procesos fiscales</strong> en la provincia de Mendoza. Desarrollado específicamente para cumplir con las normativas de la <em>Administración Tributaria de Mendoza (ATM)</em> y compatible con todos los <strong>juzgados civiles, comerciales y penales</strong> de las distintas circunscripciones judiciales.
        </p>
        <div class="flex flex-wrap justify-center gap-2 text-xs">
          <span class="bg-[var(--card-bg-alt)] text-[var(--white)] px-3 py-1 rounded-full border border-[var(--border-color)]">Estudios Jurídicos Mendoza</span>
          <span class="bg-[var(--card-bg-alt)] text-[var(--white)] px-3 py-1 rounded-full border border-[var(--border-color)]">Abogados Fiscalistas</span>
          <span class="bg-[var(--card-bg-alt)] text-[var(--white)] px-3 py-1 rounded-full border border-[var(--border-color)]">Procuradores Fiscales</span>
          <span class="bg-[var(--card-bg-alt)] text-[var(--white)] px-3 py-1 rounded-full border border-[var(--border-color)]">Gestión Tributaria</span>
