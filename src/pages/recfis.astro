<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById("recfis-contact-form");
    const submitText = document.getElementById("recfis-submit-text");
    const loadingSpinner = document.getElementById("recfis-loading-spinner");
    const contactHeader = document.getElementById("contact-header");
    const contactContent = document.getElementById("contact-content");
    const toggleEndpointsBtn = document.getElementById('toggle-endpoints');
    const endpointsBlock = document.getElementById('endpoints');

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(form);

        // Mostrar loading
        submitText.classList.add("hidden");
        loadingSpinner.classList.remove("hidden");

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" },
          });
          
          if (response.ok) {
            form.reset();
            
            // Ocultar títulos y contenido del formulario
            contactHeader.style.display = "none";
            contactContent.style.display = "none";
            
            // Mostrar mensaje de éxito centrado
            const messageDiv = document.getElementById('recfis-form-message');
            if (messageDiv) {
              messageDiv.classList.add('flex');
              messageDiv.classList.remove('hidden');
              // Forzar un reflow antes de aplicar las transiciones
              messageDiv.offsetHeight;
              requestAnimationFrame(() => {
                messageDiv.classList.remove('opacity-0', 'translate-y-8');
                messageDiv.classList.add('opacity-100', 'translate-y-0');
              });
              
              // Restaurar el formulario después de 5 segundos
              setTimeout(() => {
                messageDiv.classList.remove('opacity-100', 'translate-y-0');
                messageDiv.classList.add('opacity-0', 'translate-y-8');
                setTimeout(() => {
                  messageDiv.classList.add('hidden');
                  messageDiv.classList.remove('flex');
                  contactHeader.style.display = "block";
                  contactContent.style.display = "grid";
                }, 700);
              }, 5000);
            }
          } else {
            const data = await response.json();
            console.error("Error response:", data);
            alert("Hubo un problema al enviar tu mensaje. Por favor, intenta nuevamente.");
          }
        } catch (error) {
          console.error("Error:", error);
          alert("Hubo un problema al enviar tu mensaje. Por favor, intenta nuevamente.");
        } finally {
          loadingSpinner.classList.add("hidden");
          submitText.classList.remove("hidden");
        }
      });
    }

    // Toggle de endpoints
    if (toggleEndpointsBtn && endpointsBlock) {
      toggleEndpointsBtn.addEventListener('click', () => {
        endpointsBlock.classList.toggle('hidden');
        if (!endpointsBlock.classList.contains('hidden')) {
          // scroll suave al bloque
          const y = endpointsBlock.getBoundingClientRect().top + window.pageYOffset - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      });
    }

    // Animaciones de aparición en scroll
    const revealCards = document.querySelectorAll('.reveal-card');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('reveal-in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    revealCards.forEach((el) => io.observe(el));
  });
</script>

