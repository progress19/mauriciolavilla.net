    margin-bottom: 1.5rem;
  }
  
  .feature-hero-description {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: var(--white);
    opacity: 0.9;
    margin-bottom: 2.5rem;
    max-width: 42rem;
  }

  /* Modern Features Grid */
  .modern-features-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  
  @media (min-width: 640px) {
    .modern-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .modern-features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .modern-feature-chip {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: linear-gradient(135deg, var(--card-bg)/80, var(--card-bg-alt)/80);
    border: 1px solid var(--border-color);
    border-radius: 1.25rem;
    padding: 1.5rem 1.25rem;
    backdrop-filter: blur(10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .modern-feature-chip:hover {
    transform: translateY(-2px);
    border-color: var(--sec)/50;
    box-shadow: 0 10px 30px rgba(164, 118, 255, 0.15);
  }
  
  .chip-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  
  .chip-icon.processing {
    background: linear-gradient(135deg, #ff6b6b/20, #ff8e8e/10);
  }
  
  .chip-icon.integration {
    background: linear-gradient(135deg, #4ecdc4/20, #45b7b8/10);
  }
  
  .chip-icon.ai {
    background: linear-gradient(135deg, var(--sec)/20, var(--sec)/10);
  }
  
  .chip-content {
    flex: 1;
  }
  
  .chip-title {
    color: var(--white);
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  
  .chip-desc {
    color: var(--white);
    opacity: 0.7;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Modern Pills */
  .modern-pills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  
  .modern-pill {
    display: inline-flex;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    transition: all 0.3s ease;
  }
  
  .modern-pill:hover {
    border-color: var(--sec)/50;
    background: var(--sec)/10;
  }
  
  /* Feature Actions */
  .feature-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  @media (min-width: 768px) {
    .feature-actions {
      flex-direction: row;
      align-items: center;
    }
  }
  
  .cta-primary-feature {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: var(--sec);
    color: var(--background);
    padding: 1rem 2rem;
    border-radius: 1rem;
    font-weight: 700;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 8px 25px rgba(164, 118, 255, 0.3);
  }
  
  .cta-primary-feature:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(164, 118, 255, 0.4);
    background: #c5a3ff;
  }
  
  .cta-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.6s;
  }
  
  .cta-primary-feature:hover .cta-shine {
    left: 100%;
  }
  
  .cta-secondary-feature {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--white);
    border: 2px solid var(--border-color);
    padding: 1rem 2rem;
    border-radius: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  
  .cta-secondary-feature:hover {
    border-color: var(--sec);
    color: var(--sec);
    background: var(--sec)/10;
  }

  /* Modern Dropzone */
  .modern-dropzone {
    position: relative;
    background: linear-gradient(135deg, var(--card-bg)/60, var(--card-bg-alt)/60);
    border: 2px dashed var(--border-color);
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
    backdrop-filter: blur(10px);
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .modern-dropzone:hover {
    border-color: var(--sec)/50;
    background: linear-gradient(135deg, var(--sec)/10, var(--sec)/5);
  }
  
  .dropzone-bg-pattern {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      45deg,
      transparent 0 15px,
      var(--sec)/5 15px 30px
    );
    opacity: 0.3;
    animation: pattern-move 20s linear infinite;
  }
  
  @keyframes pattern-move {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 60px 0;
    }
  }
  
  .dropzone-glow {
    position: absolute;
    inset: -2px;
    background: conic-gradient(from 180deg, var(--sec)/20, transparent, var(--sec)/20);
    border-radius: 1.5rem;
    opacity: 0.6;
    animation: glow-rotate 6s linear infinite;
  }
  
  .dropzone-content {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    z-index: 10;
  }
  
  .dropzone-icon-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .dropzone-icon {
    font-size: 2rem;
    filter: drop-shadow(0 4px 20px rgba(164, 118, 255, 0.4));
    z-index: 2;
    position: relative;
  }
  
  .upload-animation {
    position: absolute;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--sec);
    border-top-color: transparent;
    border-radius: 50%;
    animation: upload-spin 2s linear infinite;
    opacity: 0.6;
  }
  
  @keyframes upload-spin {
    to {
      transform: rotate(360deg);
    }
  }
  
  .dropzone-text {
    flex: 1;
  }
  
  .dropzone-title {
    color: var(--white);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.25rem;
  }
  
  .dropzone-subtitle {
    color: var(--white);
    opacity: 0.7;
    font-size: 0.875rem;
  }
  
  .processing-preview {
    position: relative;
    z-index: 10;
  }
  
  .progress-container {
    margin-bottom: 1rem;
  }
  
  .progress-bar {
    position: relative;
    height: 0.75rem;
    background: var(--card-bg-alt);
    border-radius: 2rem;
    border: 1px solid var(--border-color);
    overflow: hidden;
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--sec), #e0c3ff);
    border-radius: 2rem;
    transition: width 0.6s ease;
    position: relative;
  }
  
  .progress-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: progress-shine 2s infinite;
  }
  
  @keyframes progress-shine {
    to {
      left: 100%;
    }
  }
  
  .progress-text {
    color: var(--white);
    font-size: 0.875rem;
    font-weight: 600;
    margin-top: 0.5rem;
    display: block;
  }
  
  .stats-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  
  .stat-item {
    text-align: center;
    padding: 0.75rem 0.5rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-color);
    background: var(--card-bg)/50;
    backdrop-filter: blur(10px);
  }
  
  .stat-item.success {
    border-color: #10b981/30;
    background: #10b981/10;
  }
  
  .stat-item.pending {
    border-color: #f59e0b/30;
    background: #f59e0b/10;
  }
  
  .stat-item.error {
    border-color: #ef4444/30;
    background: #ef4444/10;
  }
  
  .stat-number {
    display: block;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--white);
    line-height: 1.2;
  }
  
  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--white);
    opacity: 0.8;
    margin-top: 0.25rem;
  }

  /* Features Section Styles */
  .features-section {
    background: linear-gradient(180deg, var(--background) 0%, var(--card-bg)/50 100%);
    border-top: 1px solid var(--border-color);
    position: relative;
  }
  
  .features-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--sec)/50, transparent);
  }
  
  .features-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  /* Version Comparison */
  .versions-comparison {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  @media (min-width: 1024px) {
    .versions-comparison {
      grid-template-columns: 1fr 1.2fr;
      gap: 3rem;
    }
  }
  
  .version-card {
    position: relative;
    background: linear-gradient(135deg, var(--card-bg)/90, var(--card-bg-alt)/90);
    border-radius: 1.5rem;
    border: 1px solid var(--border-color);
    padding: 2rem;
    backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }
  
  .version-card.featured {
    border: 2px solid var(--sec)/50;
    transform: scale(1.02);
  }
  
  .version-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 20px 60px rgba(164, 118, 255, 0.15);
  }
  
  .version-card.featured:hover {
    transform: translateY(-4px) scale(1.04);
  }
  
  .version-header {
    margin-bottom: 2rem;
    position: relative;
  }
  
  .version-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  
  .version-badge.standard {
    background: var(--card-bg-alt);
    color: var(--white);
    border: 1px solid var(--border-color);
  }
  
  .version-badge.full {
    background: var(--sec);
    color: var(--background);
    box-shadow: 0 4px 20px rgba(164, 118, 255, 0.3);
  }
  
  .recommended-badge {
    position: absolute;
    top: -0.5rem;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #1f2937;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    box-shadow: 0 4px 15px rgba(251, 191, 36, 0.3);
    animation: pulse-badge 3s infinite;
  }
  
  @keyframes pulse-badge {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }
  
  .version-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--sec);
    margin-bottom: 0.5rem;
  }
  
  .version-subtitle {
    color: var(--white);
    opacity: 0.8;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  
  .included-notice {
    color: var(--white);
    font-size: 0.875rem;
    opacity: 0.7;
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    position: relative;
  }
  
  .feature-item.premium {
    padding: 1rem;
    background: linear-gradient(135deg, var(--sec)/10, var(--sec)/5);
    border-radius: 1rem;
    border: 1px solid var(--sec)/20;
  }
  
  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    font-size: 1.25rem;
    flex-shrink: 0;
    background: var(--card-bg-alt);
    border: 1px solid var(--border-color);
  }
  
  .feature-icon.boletas {
    background: linear-gradient(135deg, #3b82f6/20, #1d4ed8/10);
  }
  
  .feature-icon.honorarios {
    background: linear-gradient(135deg, #10b981/20, #059669/10);
  }
  
  .feature-icon.consulta {
    background: linear-gradient(135deg, #8b5cf6/20, #7c3aed/10);
  }
  
  .feature-icon.informes {
    background: linear-gradient(135deg, #f59e0b/20, #d97706/10);
  }
  
  .feature-icon.partes {
    background: linear-gradient(135deg, #ef4444/20, #dc2626/10);
  }
  
  .feature-icon.admin {
    background: linear-gradient(135deg, #6b7280/20, #4b5563/10);
  }
  
  .feature-icon.ai {
    background: linear-gradient(135deg, var(--sec)/30, var(--sec)/15);
  }
  
  .feature-icon.banking {
    background: linear-gradient(135deg, #06b6d4/20, #0891b2/10);
  }
  
  .feature-icon.reports {
    background: linear-gradient(135deg, #84cc16/20, #65a30d/10);
  }
  
  .feature-content {
    flex: 1;
  }
  
  .feature-name {
    color: var(--white);
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  
  .feature-desc {
    color: var(--white);
    opacity: 0.8;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  
  .premium-indicator {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--sec);
    color: var(--background);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .cta-container {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
  
  .version-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--sec);
    color: var(--background);
    padding: 0.875rem 1.5rem;
    border-radius: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    width: 100%;
    justify-content: center;
    box-shadow: 0 8px 25px rgba(164, 118, 255, 0.3);
  }
  
  .version-cta:hover {
    background: #c5a3ff;
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(164, 118, 255, 0.4);
  }
  
  .version-cta .cta-arrow {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s ease;
  }
  
  .version-cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* Form Styles and Responsive Enhancements */
  select option {
    background-color: var(--background);
    color: var(--white);
  }
  
  ::placeholder {
    color: var(--white-icon);
    opacity: 0.7;
  }
  
  input:focus, select:focus, textarea:focus {
    box-shadow: 0 0 0 3px rgba(164, 118, 255, 0.1);
  }
  
  [data-theme="light"] input:focus,
  [data-theme="light"] select:focus, 
  [data-theme="light"] textarea:focus {
    box-shadow: 0 0 0 3px rgba(111, 75, 175, 0.1);
  }
  
  /* Animation enhancements */
  .reveal-card {
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  .reveal-card.reveal-in {
    transform: translateY(0);
    opacity: 1;
  }
  
  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .hero-actions {
      gap: 0.75rem;
    }
    
    .cta-primary-hero {
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
    }
    
    .cta-secondary-hero {
      padding: 0.875rem 1.5rem;
      font-size: 1rem;
    }
    
    .modern-features-grid {
      grid-template-columns: 1fr;
    }
    
    .feature-hero-card {
      padding: 2rem 1.5rem;
    }
    
    .version-card {
      padding: 1.5rem;
    }
    
    .versions-comparison {
      grid-template-columns: 1fr;
    }
    
    .modern-dropzone {
      padding: 1.5rem 1rem;
    }
    
    .dropzone-content {
      flex-direction: column;
      text-align: center;
      gap: 0.75rem;
    }
    
    .stats-container {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    
    .trust-indicators {
      flex-direction: column;
      gap: 1rem;
    }
  }
  
  @media (max-width: 480px) {
    .metrics-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .feature-actions {
      gap: 0.75rem;
    }
    
    .modern-pills-container {
      justify-content: center;
    }
    
    .modern-pill {
      font-size: 0.75rem;
      padding: 0.375rem 0.75rem;
    }
  }
  
  /* Revolutionary Import System Styles */
  
  /* Section Background & Layout */
  .import-hero-gradient {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 100% 60% at 50% 0%, rgba(164, 118, 255, 0.15), transparent 70%),
      radial-gradient(ellipse 80% 50% at 20% 100%, rgba(164, 118, 255, 0.08), transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 50%, rgba(164, 118, 255, 0.06), transparent 50%);
    pointer-events: none;
  }
  
  .import-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(164, 118, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(164, 118, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: grid-drift 30s linear infinite;
    pointer-events: none;
  }
  
  @keyframes grid-drift {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }
  
  /* Premium Badges */
  .premium-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--sec), #c5a3ff);
    color: var(--background);
    font-size: 0.875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    overflow: hidden;
    box-shadow: 
      0 8px 32px rgba(164, 118, 255, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  }
  
  .premium-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: premium-shine 3s ease-in-out infinite;
  }
  
  @keyframes premium-shine {
    0%, 100% { left: -100%; }
    50% { left: 100%; }
  }
  
  .premium-icon {
    font-size: 1rem;
    filter: drop-shadow(0 2px 8px rgba(255, 255, 255, 0.3));
  }
  
  .tech-badge {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, var(--card-bg)/90, var(--card-bg-alt)/90);
    border: 1px solid var(--sec)/30;
    color: var(--sec);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 1.5rem;
    backdrop-filter: blur(10px);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  /* Hero Typography */
  .import-hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 2rem;
    text-align: center;
  }
  
  .title-highlight {
    display: block;
    background: linear-gradient(135deg, var(--sec), #e0c3ff, var(--sec));
    background-size: 200% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: title-gradient 4s ease-in-out infinite;
  }
  
  @keyframes title-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .title-subtitle {
    display: block;
    color: var(--white);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    margin-top: 0.75rem;
    opacity: 0.9;
  }
  
  .import-hero-description {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    line-height: 1.7;
    color: var(--white);
    opacity: 0.9;
    max-width: 50rem;
    margin: 0 auto;
    text-align: center;
  }
  
  .metric-highlight {
    background: linear-gradient(135deg, var(--sec), #e0c3ff);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 800;
    font-size: 1.1em;
  }
  
  /* Main Grid Layout */
  .import-main-grid {
    display: grid;
    gap: 4rem;
    margin-top: 4rem;
  }
  
  @media (min-width: 1200px) {
    .import-main-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 5rem;
    }
  }
  
  /* Features Column */
  .import-features-column {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  
  .capabilities-showcase {
    background: linear-gradient(135deg, var(--card-bg)/80, var(--card-bg-alt)/80);
    border: 1px solid var(--border-color);
    border-radius: 2rem;
    padding: 2.5rem;
    backdrop-filter: blur(20px);
    position: relative;
    overflow: hidden;
  }
  
  .capabilities-showcase::before {
    content: '';
    position: absolute;
    inset: -1px;
    background: conic-gradient(from 180deg, var(--sec)/20, transparent, var(--sec)/20);
    border-radius: 2rem;
    z-index: -1;
    animation: capabilities-glow 8s linear infinite;
  }
  
  @keyframes capabilities-glow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  .capabilities-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--sec);
    margin-bottom: 2rem;
    text-align: center;
  }
  
  .capability-cards-grid {
    display: grid;
    gap: 1.5rem;
  }
  
  @media (min-width: 640px) {
    .capability-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .capability-card {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    background: linear-gradient(135deg, var(--card-bg-alt)/60, var(--card-bg)/60);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 1.75rem 1.5rem;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  
  .capability-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent, var(--sec)/5, transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  
  .capability-card:hover {
    transform: translateY(-4px);
    border-color: var(--sec)/40;
    box-shadow: 0 20px 40px rgba(164, 118, 255, 0.15);
  }
  
  .capability-card:hover::before {
    opacity: 1;
  }
  
  .capability-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    flex-shrink: 0;
    overflow: hidden;
  }
  
  .icon-bg {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
  }
  
  .processing-bg {
    background: linear-gradient(135deg, #ff6b6b/20, #ff8e8e/10);
    box-shadow: 0 8px 32px rgba(255, 107, 107, 0.2);
  }
  
  .integration-bg {
    background: linear-gradient(135deg, #4ecdc4/20, #45b7b8/10);
    box-shadow: 0 8px 32px rgba(78, 205, 196, 0.2);
  }
  
  .validation-bg {
    background: linear-gradient(135deg, #a8e6cf/20, #88d8a3/10);
    box-shadow: 0 8px 32px rgba(168, 230, 207, 0.2);
  }
  
  .analytics-bg {
    background: linear-gradient(135deg, #ffd93d/20, #ffcd3c/10);
    box-shadow: 0 8px 32px rgba(255, 217, 61, 0.2);
  }
  
  .icon-symbol {
    position: relative;
    font-size: 1.5rem;
    z-index: 1;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
  }
  
  .capability-content {
    flex: 1;
    min-width: 0;
  }
  
  .capability-name {
    color: var(--white);
    font-weight: 700;
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  
  .capability-desc {
    color: var(--white);
    opacity: 0.8;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  
  .capability-metric {
    background: var(--sec)/10;
    color: var(--sec);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.375rem 0.75rem;
    border-radius: 0.75rem;
    display: inline-block;
    border: 1px solid var(--sec)/20;
  }
  
  /* Advanced Features List */
  .advanced-features-list {
    background: linear-gradient(135deg, var(--card-bg)/60, var(--card-bg-alt)/60);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 2rem;
    backdrop-filter: blur(10px);
  }
  
  .features-list-title {
    color: var(--white);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  
  .feature-pill.advanced {
    background: linear-gradient(135deg, var(--sec)/15, var(--sec)/8);
    border: 1px solid var(--sec)/25;
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    text-align: center;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .feature-pill.advanced:hover {
    background: linear-gradient(135deg, var(--sec)/25, var(--sec)/15);
    border-color: var(--sec)/40;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(164, 118, 255, 0.15);
  }
  
  /* Demo Column */
  .import-demo-column {
    position: relative;
  }
  
  .demo-container {
    background: linear-gradient(135deg, var(--card-bg)/85, var(--card-bg-alt)/85);
    border: 1px solid var(--border-color);
    border-radius: 2rem;
    padding: 2rem;
    backdrop-filter: blur(20px);
    box-shadow: 
      0 25px 80px rgba(0, 0, 0, 0.15),
      0 10px 30px rgba(164, 118, 255, 0.1);
    position: relative;
    overflow: hidden;
  }
  
  .demo-container::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(45deg, var(--sec)/20, transparent 30%, var(--sec)/10 70%, var(--sec)/20);
    background-size: 400% 400%;
    border-radius: 2rem;
    z-index: -1;
    animation: demo-glow 6s ease-in-out infinite;
  }
  
  @keyframes demo-glow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  
  .demo-title {
    color: var(--sec);
    font-weight: 800;
    font-size: 1.5rem;
  }
  
  .demo-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .status-indicator {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
    animation: status-pulse 2s infinite;
  }
  
  @keyframes status-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.1); }
  }
  
  .status-text {
    color: var(--white);
    font-size: 0.875rem;
    font-weight: 600;
  }
  
  /* Enhanced Upload Zone */
  .upload-zone-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .upload-zone {
    position: relative;
    border: 3px dashed var(--border-color);
    border-radius: 1.5rem;
    padding: 2.5rem 2rem;
    text-align: center;
    transition: all 0.4s ease;
    overflow: hidden;
  }
  
  .upload-zone:hover {
    border-color: var(--sec)/50;
    background: linear-gradient(135deg, var(--sec)/8, var(--sec)/4);
  }
  
  .upload-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  .upload-pattern {
    position: absolute;
    inset: 0;
    background: 
      repeating-linear-gradient(
        45deg,
        transparent 0 20px,
        var(--sec)/5 20px 40px
      );
    animation: upload-pattern-move 15s linear infinite;
  }
  
  @keyframes upload-pattern-move {
    0% { transform: translateX(-40px); }
    100% { transform: translateX(0); }
  }
  
  .upload-glow {
    position: absolute;
    inset: -3px;
    background: conic-gradient(from 180deg, var(--sec)/15, transparent, var(--sec)/15);
    border-radius: 1.5rem;
    animation: upload-glow-rotate 8s linear infinite;
  }
  
  @keyframes upload-glow-rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  .upload-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  
  .upload-icon-container {
    position: relative;
    width: 5rem;
    height: 5rem;
  }
  
  .upload-icon {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .icon-layers {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .icon-layer {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: 2rem;
    transform: translate(-50%, -50%);
    animation: icon-float 4s ease-in-out infinite;
  }
  
  .layer-1 {
    animation-delay: 0s;
    z-index: 3;
  }
  
  .layer-2 {
    animation-delay: -1.3s;
    z-index: 2;
    opacity: 0.6;
  }
  
  .layer-3 {
    animation-delay: -2.6s;
    z-index: 1;
    opacity: 0.3;
  }
  
  @keyframes icon-float {
    0%, 100% {
      transform: translate(-50%, -50%) translateY(0px) scale(1);
      opacity: 1;
    }
    33% {
      transform: translate(-50%, -50%) translateY(-10px) scale(1.1);
      opacity: 0.8;
    }
    66% {
      transform: translate(-50%, -50%) translateY(5px) scale(0.95);
      opacity: 0.6;
    }
  }
  
  .upload-pulse {
    position: absolute;
    inset: -10px;
    border: 2px solid var(--sec);
    border-radius: 50%;
    opacity: 0;
    animation: upload-pulse-anim 3s ease-out infinite;
  }
  
  @keyframes upload-pulse-anim {
    0% {
      transform: scale(0.8);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }
  
  .upload-text {
    text-align: center;
  }
  
  .upload-title {
    color: var(--white);
    font-weight: 700;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .upload-subtitle {
    color: var(--white);
    opacity: 0.8;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  
  .upload-limit {
    color: var(--white);
    opacity: 0.6;
    font-size: 0.875rem;
  }
  
  .browse-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--sec);
    color: var(--background);
    font-weight: 700;
    padding: 1rem 2rem;
    border-radius: 1rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(164, 118, 255, 0.3);
  }
  
  .browse-button:hover {
    background: #c5a3ff;
    transform: translateY(-2px);
    box-shadow: 0 12px 35px rgba(164, 118, 255, 0.4);
  }
  
  .browse-icon {
    font-size: 1.125rem;
  }
  
  /* Processing Simulation */
  .processing-simulation {
    background: linear-gradient(135deg, var(--card-bg-alt)/80, var(--card-bg)/80);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem;
    padding: 2rem;
    backdrop-filter: blur(10px);
  }
  
  .processing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  
  .processing-title {
    color: var(--white);
    font-weight: 700;
    font-size: 1.125rem;
  }
  
  .processing-speed {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--sec)/15;
    color: var(--sec);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 0.75rem;
    border-radius: 1rem;
    border: 1px solid var(--sec)/20;
  }
  
  .progress-visualization {
    margin-bottom: 2rem;
  }
  
  .progress-track {
    position: relative;
    height: 1rem;
    background: var(--card-bg-alt);
    border: 1px solid var(--border-color);
    border-radius: 2rem;
    overflow: hidden;
  }
  
  .progress-fill-advanced {
    height: 100%;
    background: linear-gradient(90deg, var(--sec), #e0c3ff, var(--sec));
    background-size: 200% 100%;
    border-radius: 2rem;
    position: relative;
    transition: width 0.8s ease;
    animation: progress-gradient 3s ease-in-out infinite;
  }
  
  @keyframes progress-gradient {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  .progress-pattern {
    position: absolute;
    inset: 0;
    background: 
      repeating-linear-gradient(
        90deg,
        transparent 0 10px,
        rgba(255, 255, 255, 0.1) 10px 20px
      );
    animation: progress-pattern-move 2s linear infinite;
  }
  
  @keyframes progress-pattern-move {
    0% { transform: translateX(-20px); }
    100% { transform: translateX(0); }
  }
  
  .progress-glow {
    position: absolute;
    inset: -2px;
    background: linear-gradient(90deg, var(--sec)/50, transparent, var(--sec)/50);
    border-radius: 2rem;
    filter: blur(4px);
  }
  
  .progress-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
  }
  
  .progress-percentage {
    color: var(--white);
    font-weight: 800;
    font-size: 1.25rem;
  }
  
  .progress-speed {
    color: var(--white);
    opacity: 0.8;
    font-size: 0.875rem;
    font-weight: 600;
  }
  
  /* Statistics Dashboard */
  .stats-dashboard {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .stat-card {
    background: linear-gradient(135deg, var(--card-bg)/80, var(--card-bg-alt)/80);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    padding: 1.25rem 1rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(10px);
  }
  
  .stat-card.processed {
    border-color: #10b981/30;
    background: linear-gradient(135deg, #10b981/15, #10b981/8);
  }
  
  .stat-card.pending {
    border-color: #f59e0b/30;
    background: linear-gradient(135deg, #f59e0b/15, #f59e0b/8);
  }
  
  .stat-card.errors {
    border-color: #ef4444/30;
    background: linear-gradient(135deg, #ef4444/15, #ef4444/8);
  }
  
  .stat-icon {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
  }
  
  .stat-data {
    margin-bottom: 0.5rem;
  }
  
  .stat-number {
    color: var(--white);
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.2;
    display: block;
  }
  
  .stat-label {
    color: var(--white);
    opacity: 0.8;
    font-size: 0.75rem;
    font-weight: 500;
    display: block;
    margin-top: 0.25rem;
  }
  
  .stat-trend {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    display: inline-block;
  }
  
  .stat-trend.up {
    color: #10b981;
    background: #10b981/15;
  }
  
  .stat-trend.down {
    color: #ef4444;
    background: #ef4444/15;
  }
  
  .stat-trend.stable {
    color: #6b7280;
    background: #6b7280/15;
  }
  
  /* AI Validation Panel */
  .validation-panel {
    background: linear-gradient(135deg, var(--sec)/10, var(--sec)/5);
    border: 1px solid var(--sec)/20;
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(10px);
  }
  
  .validation-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  
  .validation-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 2px 8px rgba(164, 118, 255, 0.3));
  }
  
  .validation-title {
    color: var(--white);
    font-weight: 700;
    font-size: 1rem;
    flex: 1;
  }
  
  .validation-status {
    background: var(--sec);
    color: var(--background);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    letter-spacing: 0.05em;
  }
  
  .validation-insights {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  
  .insight-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .insight-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex-shrink: 0;
  }
  
  .insight-dot.success {
    background: #10b981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
  }
  
  .insight-dot.warning {
    background: #f59e0b;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
  }
  
  .insight-dot.info {
    background: #3b82f6;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
  }
  
  .insight-text {
    color: var(--white);
    opacity: 0.9;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  
  /* Bottom CTA Section */
  .import-cta-section {
    margin-top: 5rem;
    text-align: center;
  }
  
  .cta-content {
    margin-bottom: 3rem;
  }
  
  .cta-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: var(--sec);
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }
  
  .cta-description {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: var(--white);
    opacity: 0.9;
    max-width: 40rem;
    margin: 0 auto 2.5rem;
  }
  
  .cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }
  
  @media (min-width: 640px) {
    .cta-buttons {
      flex-direction: row;
      justify-content: center;
    }
  }
  
  .cta-primary-import {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: var(--sec);
    color: var(--background);
    font-weight: 800;
    font-size: 1.125rem;
    padding: 1.25rem 2.5rem;
    border-radius: 1.5rem;
    text-decoration: none;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 
      0 12px 40px rgba(164, 118, 255, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  }
  
  .cta-primary-import:hover {
    background: #c5a3ff;
    transform: translateY(-4px) scale(1.02);
    box-shadow: 
      0 20px 60px rgba(164, 118, 255, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset;
  }
  
  .cta-glow {
    position: absolute;
    inset: -2px;
    background: conic-gradient(from 180deg, var(--sec)/50, transparent, var(--sec)/50);
    border-radius: 1.5rem;
    z-index: -1;
    animation: cta-glow-rotate 6s linear infinite;
  }
  
  @keyframes cta-glow-rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  .cta-text {
    position: relative;
    z-index: 1;
  }
  
  .cta-arrow {
    position: relative;
    z-index: 1;
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }
  
  .cta-primary-import:hover .cta-arrow {
    transform: translateX(4px);
  }
  
  .cta-secondary-import {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    color: var(--white);
    font-weight: 700;
    font-size: 1.125rem;
    padding: 1.25rem 2rem;
    border: 2px solid var(--border-color);
    border-radius: 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }
  
  .cta-secondary-import:hover {
    border-color: var(--sec);
    color: var(--sec);
    background: var(--sec)/10;
    transform: translateY(-2px);
  }
  
  .cta-icon {
    font-size: 1.125rem;
  }
  
  /* Trust Badges */
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 2rem;
