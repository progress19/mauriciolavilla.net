---
import LanguageSelector from "./LanguageSelector.astro";

interface NavItem {
  label: string;
  href: string;
  translateKey: string;
}

const navItems: NavItem[] = [
  {
    label: "Inicio",
    href: "#home",
    translateKey: "nav.home"
  },
  {
    label: "Desarrollo",
    href: "#services",
    translateKey: "nav.development"
  },
  {
    label: "Diseño",
    href: "#design",
    translateKey: "nav.design"
  },
  {
    label: "IA",
    href: "#ai",
    translateKey: "nav.ai"
  },
  {
    label: "Infraestructura",
    href: "#infrastructure",
    translateKey: "nav.infrastructure"
  },
  {
    label: "RecFis",
    href: "/recfis",
    translateKey: "nav.recfis"
  },
  {
    label: "Contacto",
    href: "#contact",
    translateKey: "nav.contact"
  },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--background)]/80 backdrop-blur-md border-b border-[var(--white-icon-tr)]">
  <div class="max-w-6xl mx-auto px-4 md:px-12">
    <div class="flex items-center justify-between h-16">
      <!-- Logo/Nombre -->
      <div class="flex-shrink-0">
        <a 
          href="#home" 
          class="text-xl font-medium text-[var(--white)] hover:text-[var(--sec)] transition-colors duration-300"
        >
          &lt;/&gt;
        </a>
      </div>

      <!-- Menú de navegación -->
      <div class="hidden md:block">
        <div class="flex items-center space-x-8">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link relative text-[var(--white-icon)] hover:text-[var(--white)] transition-colors duration-300 text-sm font-medium py-2 px-1 group"
              data-translate={item.translateKey}
            >
              {item.label}
              <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[var(--sec)] transition-all duration-300 group-hover:w-full"></span>
            </a>
          ))}
        </div>
      </div>

      <!-- Selector de idiomas y menú móvil -->
      <div class="flex items-center gap-4 mr-12 md:mr-0">
        <!-- Selector de idiomas -->
        <LanguageSelector />

        <!-- Menú móvil hamburguesa -->
        <div class="md:hidden">
          <button
            id="mobile-menu-button"
            class="text-[var(--white-icon)] hover:text-[var(--white)] transition-colors duration-300 p-2"
            aria-label="Abrir menú"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Menú móvil desplegable -->
    <div id="mobile-menu" class="md:hidden hidden">
      <div class="px-2 pt-2 pb-6 space-y-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link block px-4 py-3 text-[var(--white-icon)] hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)] rounded-lg transition-all duration-300 text-sm font-medium"
            data-translate={item.translateKey}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<!-- Espaciado para el nav fijo -->
<div class="h-16"></div>

<style>
  /* Efecto activo para enlaces de navegación */
  .nav-link.active {
    color: var(--white) !important;
  }
  
  .nav-link.active span {
    width: 100% !important;
  }

  .mobile-nav-link.active {
    color: var(--white) !important;
    background-color: var(--white-icon-tr) !important;
  }

  /* Animación suave para el menú móvil */
  #mobile-menu {
    transition: all 0.3s ease-in-out;
  }

  #mobile-menu.show {
    display: block !important;
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Efecto de scroll para la navbar */
  .nav-scrolled {
    background-color: var(--background) !important;
    border-bottom: 1px solid var(--border-color) !important;
    backdrop-filter: blur(20px);
  }
  
  /* Navbar específico para tema claro */
  [data-theme="light"] .nav-scrolled {
    background-color: rgba(255, 255, 255, 0.95) !important;
    border-bottom: 1px solid rgba(224, 224, 224, 0.8) !important;
  }
</style>

<script>
  // Función para aplicar traducciones a la navegación
  function applyNavTranslations(language: string) {
    const translations = (window as any).translations;
    const currentTranslations = translations[language] || translations.es;
    
    // Traducir elementos de navegación
    document.querySelectorAll('[data-translate]').forEach(element => {
      const key = element.getAttribute('data-translate');
      if (key && key.startsWith('nav.')) {
        const translation = getNestedValue(currentTranslations, key);
        if (translation) {
          element.textContent = translation;
        }
      }
    });
  }

  // Función para obtener valores anidados de un objeto
  function getNestedValue(obj: any, path: string) {
    return path.split('.').reduce((current, key) => current?.[key], obj);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('.nav-link, .mobile-nav-link');
    const navbar = document.querySelector('nav');

    // Aplicar traducciones iniciales
    const savedLanguage = localStorage.getItem('selectedLanguage') || 'es';
    applyNavTranslations(savedLanguage);

    // Escuchar cambios de idioma
    window.addEventListener('languageChanged', (event: any) => {
      applyNavTranslations(event.detail.language);
    });

    // Toggle menú móvil
    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      mobileMenu?.classList.toggle('show');
    });

    // Cerrar menú móvil al hacer click en un enlace
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        
        // Si es un enlace externo (no empieza con #), permitir navegación normal
        if (href && !href.startsWith('#')) {
          // No prevenir el comportamiento por defecto para enlaces externos
          // Cerrar menú móvil
          mobileMenu?.classList.add('hidden');
          mobileMenu?.classList.remove('show');
          return;
        }
        
        // Solo prevenir comportamiento por defecto para anclas internas
        e.preventDefault();
        const target = document.querySelector(href as string) as HTMLElement;
        
        if (target) {
          // Smooth scroll con offset para el navbar fijo
          const offsetTop = target.offsetTop - 80;
          window.scrollTo({
            top: offsetTop,
            behavior: 'smooth'
          });
        }

        // Cerrar menú móvil
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('show');
      });
    });

    // Efecto de scroll en la navbar
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        navbar?.classList.add('nav-scrolled');
      } else {
        navbar?.classList.remove('nav-scrolled');
      }
    });

    // Intersection Observer para marcar sección activa
    const sections = document.querySelectorAll('section[id]');
    const observerOptions = {
      threshold: 0.3,
      rootMargin: '-80px 0px -80px 0px'
    };

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry: IntersectionObserverEntry) => {
        if (entry.isIntersecting) {
          // Remover clase activa de todos los enlaces
          navLinks.forEach(link => link.classList.remove('active'));
          
          // Agregar clase activa al enlace correspondiente
          const id = entry.target.getAttribute('id');
          const activeLinks = document.querySelectorAll(`a[href="#${id}"]`);
          activeLinks.forEach(link => link.classList.add('active'));
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach(section => observer.observe(section));
  });
</script>
