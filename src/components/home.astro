---
import LogoWall from "../components/logoWall.astro";
---

<section class="text-[var(--white)] mt-12 md:mt-0" id="home">
  <div class="max-w-5xl mx-auto space-y-8 md:py-16 pb-14">
    <div class="text-left">
      <p class="text-md md:text-2xl text-[var(--white-icon)] shiny-white" data-translate="home.name">
        Mauricio Lavilla
      </p>
      <div
        class="flex flex-col lg:flex-row lg:items-center lg:space-y-0 lg:space-x-8 md:gap-4"
      >
        <h1
          class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
          data-translate="home.role"
        >
          Full Stack <br /> Developer
        </h1>

        <div class="flex flex-col space-y-4 pt-2">
          <p class="text-md md:text-2 md:text-xl text-[var(--white-icon)]" data-translate="home.description1">
            Transformo ideas en sistemas inteligentes y escalables, fusionando
            diseño moderno con arquitecturas robustas para crear soluciones
            digitales que marcan la diferencia.
          </p>
          <p class="text-md md:text-xl text-[var(--white-icon)]" data-translate="home.description2">
            Soy un apasionado por la tecnología y la innovación, siempre en
            busca de nuevos retos y oportunidades para crecer.
          </p>
        </div>
      </div>
      <div class="flex justify-start gap-2 pt-3 md:pt-6">
        <a
          target="_blank"
          href="https://mail.google.com/mail/?view=cm&fs=1&to=info@mauriciolavilla.net&su=Hola%20Mauricio!"
          aria-label="Email"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[var(--card-bg)] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="2.1em"
            height="2.1em"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="https://github.com/progress19"
          aria-label="GitHub"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[var(--card-bg)] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
            ></path>
          </svg>
        </a>
        <a
          target="_blank"
          href="https://www.linkedin.com/in/mauriciolavilla/"
          aria-label="LinkedIn"
          class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[var(--card-bg)] hover:bg-[var(--white-icon-tr)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-8"
          >
            <path
              d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <LogoWall />

    <!-- Nueva sección: Desarrollo de Aplicaciones Web Avanzadas -->
    <section class="py-16 border-t border-[#ffffff10]" id="services">
      <div class="grid lg:grid-cols-[75%_25%] gap-12 items-center">
        <!-- Columna izquierda (75%) - Contenido principal -->
        <div class="space-y-8">
          <div class="space-y-6">
            <h2
              class="text-3xl md:text-5xl lg:text-6xl font-bold text-[var(--white)] leading-tight"
            >
              <span data-translate="home.development.title">Desarrollo de</span>
              <br />
              <span class="text-[var(--sec)] shiny-sec" data-translate="home.development.subtitle">Aplicaciones Web</span>
              <br />
              <span
                class="text-2xl md:text-4xl lg:text-5xl font-normal text-[var(--white-icon)]"
                data-translate="home.development.category">Avanzadas</span>
            </h2>

            <div
              class="space-y-6 text-lg md:text-xl text-[var(--white-icon)] leading-relaxed"
            >
              <p data-translate="home.development.description1">
                Creo <span class="text-[var(--white)] font-medium"
                  >sistemas inteligentes</span
                > que simplifican procesos complejos y conectan personas con soluciones
                prácticas.
              </p>
              <p data-translate="home.development.description2">
                Mi enfoque está en desarrollar <span class="text-[var(--sec)]"
                  >herramientas digitales</span
                > que generen un <span class="text-[var(--white)] font-medium"
                  >impacto positivo real</span
                > en la vida de las personas y organizaciones.
              </p>
              <div
                class="text-base md:text-lg bg-[var(--card-bg)] border border-[var(--white-icon-tr)] rounded-2xl p-6"
              >
                <p class="text-[var(--sec)] font-medium mb-2" data-translate="home.development.philosophy">Mi filosofía:</p>
                <p class="text-[var(--white)]" data-translate="home.development.philosophyText">
                  Tecnología + Propósito = Soluciones que importan
                </p>
              </div>
            </div>

            <!-- Lista de servicios específicos -->
            <div class="pt-6">
              <h3
                class="text-xl md:text-2xl font-semibold text-[var(--white)] mb-4"
                data-translate="home.development.servicesTitle"
              >
                Servicios especializados:
              </h3>
              <ul
                class="space-y-3 text-[var(--white-icon)] text-base md:text-lg"
                data-translate-list="home.development.services"
              >
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Creación de sitios web dinámicos y personalizados, adaptados
                    a tus necesidades.
                  </span>
                </li>
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Soluciones de comercio electrónico con integración de
                    pasarelas de pago (PayPal, Mercado Pago, Stripe).
                  </span>
                </li>
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Desarrollo de sistemas de reservas para cabañas,
                    departamentos y otros servicios.
                  </span>
                </li>
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Integración de APIs de terceros (Google Maps, OpenWeather,
                    etc.).
                  </span>
                </li>
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Optimización de sitios web para SEO.
                  </span>
                </li>
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Mantenimiento y actualización de sitios web existentes.
                  </span>
                </li>
                <li class="flex items-start">
                  <span class="text-[var(--sec)] mr-3 mt-1">•</span>
                  <span>
                    Desarrollo de aplicaciones web progresivas (PWA).
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Columna derecha (25%) - Elemento visual animado -->
        <div class="flex justify-center items-center h-full lg:flex">
          <div
            class="relative w-full max-w-xs aspect-square bg-gradient-to-br from-transparent to-transparent"
          >
            <!-- Formas fluidas que representan herramientas digitales -->

            <!-- Forma 1: Rectángulo redondeado (código/editor) -->
            <div
              class="absolute top-1/4 left-1/3 w-8 h-5 bg-purple-400 opacity-50 rounded-md animate-float1"
            >
            </div>

            <!-- Forma 2: Círculo (datos/conexión) -->
            <div
              class="absolute top-1/2 right-1/4 w-6 h-6 bg-white opacity-30 rounded-full animate-float2"
            >
            </div>

            <!-- Forma 3: Cuadrado pequeño (módulo/componente) -->
            <div
              class="absolute top-1/6 right-1/2 w-4 h-4 bg-purple-300 opacity-40 rounded-sm animate-float3"
            >
            </div>

            <!-- Forma 4: Línea ondulada (flujo de datos) -->
            <div
              class="absolute top-2/3 right-1/3 w-12 h-1 bg-purple-400 opacity-40 rounded-full animate-wave"
            >
            </div>

            <!-- Forma 5: Elipse (proceso) -->
            <div
              class="absolute bottom-1/4 right-1/5 w-7 h-4 bg-white opacity-20 rounded-full animate-float4"
            >
            </div>

            <!-- Partículas de conexión suaves -->
            <div
              class="absolute top-1/3 left-1/2 w-2 h-2 bg-purple-400 opacity-60 rounded-full animate-twinkle1"
            >
            </div>
            <div
              class="absolute bottom-1/2 left-2/3 w-1 h-1 bg-white opacity-50 rounded-full animate-twinkle2"
            >
            </div>
            <div
              class="absolute top-2/3 left-1/5 w-1 h-1 bg-purple-300 opacity-70 rounded-full animate-twinkle3"
            >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Nueva sección: Diseño -->
    <section class="py-16 border-t border-[#ffffff10]" id="design">
      <div class="grid lg:grid-cols-[25%_75%] gap-12 items-center">
        <!-- Columna izquierda (25%) - Elemento visual animado -->
        <div class="flex justify-center items-center h-full order-2 lg:order-1">
          <div
            class="relative w-full max-w-xs aspect-square bg-gradient-to-br from-transparent to-transparent"
          >
            <!-- Formas fluidas que representan diseño y creatividad -->

            <!-- Forma 1: Paleta de colores -->
            <div
              class="absolute top-1/5 left-1/4 w-10 h-6 bg-gradient-to-r from-purple-400 to-pink-300 opacity-60 rounded-lg animate-pulse"
            >
            </div>

            <!-- Forma 2: Pincel/herramienta de diseño -->
            <div
              class="absolute top-1/3 right-1/3 w-2 h-12 bg-white opacity-40 rounded-full rotate-45 animate-bounce"
            >
            </div>

            <!-- Forma 3: Ventana/frame de diseño -->
            <div
              class="absolute top-1/2 left-1/3 w-8 h-6 border-2 border-purple-300 opacity-50 rounded animate-ping"
            >
            </div>

            <!-- Forma 4: Tipografía representada como líneas -->
            <div class="absolute bottom-1/3 right-1/4 space-y-1 animate-pulse">
              <div class="w-8 h-0.5 bg-purple-400 opacity-60 rounded-full">
              </div>
              <div class="w-6 h-0.5 bg-white opacity-40 rounded-full"></div>
              <div class="w-10 h-0.5 bg-purple-300 opacity-50 rounded-full">
              </div>
            </div>

            <!-- Forma 5: Elementos de interfaz -->
            <div
              class="absolute bottom-1/4 left-1/5 w-5 h-5 bg-purple-400 opacity-40 rounded-sm animate-spin"
            >
            </div>

            <!-- Partículas creativas -->
            <div
              class="absolute top-1/6 right-1/2 w-1 h-1 bg-pink-300 opacity-70 rounded-full animate-ping"
            >
            </div>
            <div
              class="absolute bottom-1/2 left-2/3 w-2 h-2 bg-purple-400 opacity-50 rounded-full animate-pulse"
            >
            </div>
            <div
              class="absolute top-2/3 right-1/5 w-1 h-1 bg-white opacity-60 rounded-full animate-bounce"
            >
            </div>
          </div>
        </div>

        <!-- Columna derecha (75%) - Contenido principal -->
        <div class="space-y-8 order-1 lg:order-2">
          <div class="space-y-6">
            <h2
              class="text-3xl md:text-5xl lg:text-6xl font-bold text-[var(--white)] leading-tight"
            >
              <span class="block text-[var(--sec)] shiny-sec" data-translate="home.design.title">Diseño</span>
              <span data-translate="home.design.subtitle">y Maquetación</span>
              <span
                class="block text-2xl md:text-4xl lg:text-5xl font-normal text-[var(--white-icon)]"
                data-translate="home.design.category">Profesional</span>
            </h2>

            <div
              class="space-y-6 text-lg md:text-xl text-[var(--white-icon)] leading-relaxed"
            >
              <p data-translate="home.design.description1">
                Transformo conceptos en <span
                  class="text-[var(--white)] font-medium"
                  >experiencias visuales impactantes</span
                > que comunican, conectan y convierten visitantes en clientes.
              </p>
              <p data-translate="home.design.description2">
                Mi proceso combina <span class="text-[var(--sec)]"
                  >creatividad estratégica</span
                > con tecnología de vanguardia para crear interfaces que no solo
                se ven bien, sino que <span
                  class="text-[var(--white)] font-medium"
                  >generan resultados reales</span
                >.
              </p>
              <div
                class="text-base md:text-lg bg-[var(--card-bg)] border border-[var(--white-icon-tr)] rounded-2xl p-6"
              >
                <p class="text-[var(--sec)] font-medium mb-2" data-translate="home.design.philosophy">Mi enfoque:</p>
                <p class="text-[var(--white)]" data-translate="home.design.philosophyText">
                  Diseño + Funcionalidad = Experiencias que cautivan
                </p>
              </div>
            </div>

            <!-- Lista de servicios específicos -->
            <div class="pt-6">
              <h3
                class="text-xl md:text-2xl font-semibold text-[var(--white)] mb-4"
                data-translate="home.design.servicesTitle"
              >
                Servicios de diseño:
              </h3>
              <ul
                class="space-y-3 text-[var(--white-icon)] text-base md:text-lg"
                data-translate-list="home.design.services"
              >
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="0">
                    Diseño web profesional utilizando las últimas tecnologías y
                    frameworks.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="1">
                    Creación de interfaces de usuario (UI) y experiencias de
                    usuario (UX) atractivas.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="2">
                    Maquetación de sitios web responsivos y accesibles.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="3">
                    Sistemas de diseño coherentes y escalables.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="4">
                    Prototipado interactivo y testing de usabilidad.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="5">
                    Animaciones y microinteracciones que mejoran la experiencia.
                  </li>
                </div>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Nueva sección: Inteligencia Artificial -->
    <section class="py-16 border-t border-[#ffffff10]" id="ai">
      <div class="grid lg:grid-cols-[75%_25%] gap-12 items-center">
        <!-- Columna izquierda (75%) - Contenido principal -->
        <div class="space-y-8">
          <div class="space-y-6">
            <h2
              class="text-3xl md:text-5xl lg:text-6xl font-bold text-[var(--white)] leading-tight"
            >
              <span class="block text-[var(--sec)] shiny-sec" data-translate="home.ai.title">Inteligencia</span>
              <span data-translate="home.ai.subtitle">Artificial</span>
              <span
                class="block text-2xl md:text-4xl lg:text-5xl font-normal text-[var(--white-icon)]"
                data-translate="home.ai.category">Aplicada</span>
            </h2>

            <div
              class="space-y-6 text-lg md:text-xl text-[var(--white-icon)] leading-relaxed"
            >
              <p data-translate="home.ai.description1">
                Desarrollo <span class="text-[var(--white)] font-medium"
                  >soluciones inteligentes</span
                > que aprovechan el poder de la IA para automatizar procesos y crear
                experiencias personalizadas.
              </p>
              <p data-translate="home.ai.description2">
                Mi enfoque combina <span class="text-[var(--sec)]"
                  >machine learning</span
                > con desarrollo web para crear aplicaciones que <span
                  class="text-[var(--white)] font-medium"
                  >aprenden y se adaptan</span
                > a las necesidades específicas.
              </p>
              <div
                class="text-base md:text-lg bg-[var(--card-bg)] border border-[var(--white-icon-tr)] rounded-2xl p-6"
              >
                <p class="text-[var(--sec)] font-medium mb-2" data-translate="home.ai.philosophy">Mi visión:</p>
                <p class="text-[var(--white)]" data-translate="home.ai.philosophyText">
                  IA + Creatividad = Soluciones que evolucionan
                </p>
              </div>
            </div>

            <!-- Lista de servicios específicos -->
            <div class="pt-6">
              <h3
                class="text-xl md:text-2xl font-semibold text-[var(--white)] mb-4"
                data-translate="home.ai.servicesTitle"
              >
                Servicios de IA:
              </h3>
              <ul
                class="space-y-3 text-[var(--white-icon)] text-base md:text-lg"
                data-translate-list="home.ai.services"
              >
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="0">
                    Integración de modelos de lenguaje para chatbots
                    inteligentes.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="1">
                    Análisis de datos con Python y machine learning.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="2">Automatización de procesos con IA.</li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="3">
                    Sistemas de recomendación personalizados.
                  </li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="4">Procesamiento de lenguaje natural (NLP).</li>
                </div>
                <div class="flex items-start">
                  <span class="text-[var(--sec)] pl-1 pt-1">•</span>
                  <li class="pl-3" data-translate-item="5">
                    Implementación de APIs de IA y aplicaciones predictivas.
                  </li>
                </div>
              </ul>
            </div>
          </div>
        </div>

        <!-- Columna derecha (25%) - Elemento visual animado -->
        <div class="flex justify-center items-center h-full ">
          <div
            class="relative w-full max-w-xs aspect-square bg-gradient-to-br from-transparent to-transparent"
          >
            <!-- Formas fluidas que representan IA y algoritmos -->

            <!-- Forma 1: Red neural -->
            <div
              class="absolute top-1/4 left-1/3 w-6 h-6 border-2 border-purple-400 opacity-50 rounded-full animate-pulse"
            >
              <div
                class="absolute top-1/2 left-1/2 w-2 h-2 bg-purple-400 rounded-full transform -translate-x-1/2 -translate-y-1/2"
              >
              </div>
            </div>

            <!-- Forma 2: Conexiones neuronales -->
            <div
              class="absolute top-1/3 right-1/4 w-8 h-0.5 bg-white opacity-30 animate-pulse transform rotate-45"
            >
            </div>
            <div
              class="absolute top-1/2 right-1/3 w-6 h-0.5 bg-purple-300 opacity-40 animate-pulse transform -rotate-45"
            >
            </div>

            <!-- Forma 3: Nodos de procesamiento -->
            <div
