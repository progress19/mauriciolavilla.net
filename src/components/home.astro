<script>
  import { getTranslations } from '../translations.ts';

  // Función para aplicar traducciones
  function applyTranslations(language: string) {
    const translations = getTranslations(language);
    
    // Traducir elementos con data-translate
    document.querySelectorAll('[data-translate]').forEach(element => {
      const key = element.getAttribute('data-translate');
      if (key) {
        const translation = getNestedValue(translations, key);
        if (translation) {
          element.textContent = translation;
        }
      }
    });

    // Traducir elementos individuales de listas con data-translate-item
    document.querySelectorAll('[data-translate-item]').forEach(element => {
      const parentList = element.closest('[data-translate-list]');
      if (parentList) {
        const listKey = parentList.getAttribute('data-translate-list');
        const itemIndex = parseInt(element.getAttribute('data-translate-item') || '0');
        
        if (listKey) {
          const translations_list = getNestedValue(translations, listKey);
          if (Array.isArray(translations_list) && translations_list[itemIndex]) {
            element.textContent = translations_list[itemIndex];
          }
        }
      }
    });

    // Traducir listas con data-translate-list (para elementos que no tienen data-translate-item)
    document.querySelectorAll('[data-translate-list]').forEach(element => {
      const key = element.getAttribute('data-translate-list');
      if (key) {
        const translations_list = getNestedValue(translations, key);
        if (Array.isArray(translations_list)) {
          const listItems = element.querySelectorAll('li span:last-child');
          listItems.forEach((item, index) => {
            if (translations_list[index] && !item.closest('li').querySelector('[data-translate-item]')) {
              item.textContent = translations_list[index];
            }
          });
        }
      }
    });
  }

  // Función para obtener valores anidados de un objeto
  function getNestedValue(obj: any, path: string) {
    return path.split('.').reduce((current, key) => current?.[key], obj);
  }

  // Escuchar cambios de idioma
  window.addEventListener('languageChanged', (event: any) => {
    applyTranslations(event.detail.language);
  });

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const savedLanguage = localStorage.getItem('selectedLanguage') || 'es';
    applyTranslations(savedLanguage);
  });
</script>

