<footer class="w-full pb-12 pt-0 ">
  <div class="max-w-5xl mx-auto">
    <div class="mt-12 pt-8 border-t border-[#ffffff10]">
      <p class="text-center text-sm text-[var(--white-icon)] space-y-2">
        <span class="block sm:inline" data-translate="footer.copyright"
          >Copyright © 2025 <a href="https://github.com/progress19"
            >Mauricio Lavilla</a
          >. Todos los derechos reservados.</span>
      </p>
    </div>
  </div>
</footer>

<script>
  import { getTranslations } from '../translations.ts';

  // Función para aplicar traducciones al footer
  function applyFooterTranslations(language: string) {
    const translations = getTranslations(language);
    
    // Traducir elementos con data-translate
    document.querySelectorAll('[data-translate]').forEach(element => {
      const key = element.getAttribute('data-translate');
      if (key && key.startsWith('footer.')) {
        const translation = getNestedValue(translations, key);
        if (translation) {
          // Para el copyright, mantener el enlace
          if (key === 'footer.copyright') {
            element.innerHTML = translation.replace('Mauricio Lavilla', '<a href="https://github.com/progress19">Mauricio Lavilla</a>');
          } else {
            element.textContent = translation;
          }
        }
      }
    });
  }

  // Función para obtener valores anidados de un objeto
  function getNestedValue(obj: any, path: string) {
    return path.split('.').reduce((current, key) => current?.[key], obj);
  }

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const savedLanguage = localStorage.getItem('selectedLanguage') || 'es';
    applyFooterTranslations(savedLanguage);
  });

  // Escuchar cambios de idioma
  window.addEventListener('languageChanged', (event: any) => {
    applyFooterTranslations(event.detail.language);
  });
</script>
