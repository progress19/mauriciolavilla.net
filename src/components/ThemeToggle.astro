---
// Componente de cambio de tema con default configurable
interface Props {
  defaultTheme?: 'light' | 'dark';
}

const { defaultTheme = 'dark' } = Astro.props;
---

<button
  id="theme-toggle"
  class="fixed top-3 right-4 z-[60] p-2 md:p-3 bg-[var(--card-bg)] border border-[var(--border-color)] rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-105"
  aria-label="Cambiar tema"
  title="Cambiar entre tema claro y oscuro"
>
  <svg
    id="sun-icon"
    class="w-5 h-5 text-[var(--white)] hidden"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill-rule="evenodd"
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      clip-rule="evenodd"
    />
  </svg>
  <svg
    id="moon-icon"
    class="w-5 h-5 text-[var(--white)]"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    />
  </svg>
</button>

<script define:vars={{ defaultTheme }}>
  // Prevenir FOUC (Flash of Unstyled Content)
  (function() {
    const savedTheme = localStorage.getItem('theme') || defaultTheme;
    if (savedTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');
    
    // Obtener tema actual
    let currentTheme = localStorage.getItem('theme') || defaultTheme;
    
    // Función para actualizar iconos
    function updateIcons() {
      if (currentTheme === 'dark') {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }
    
    // Función para cambiar tema
    function toggleTheme() {
      currentTheme = currentTheme === 'light' ? 'dark' : 'light';
      
      // Aplicar tema
      if (currentTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
      
      // Guardar en localStorage
      localStorage.setItem('theme', currentTheme);
      
      // Actualizar iconos
      updateIcons();
    }
    
    // Configurar tema inicial
    if (currentTheme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    updateIcons();
    
    // Event listener para el botón
    themeToggle?.addEventListener('click', toggleTheme);
  });
</script>

<style>
  #theme-toggle {
    backdrop-filter: blur(10px);
  }
  
  #theme-toggle:hover {
    transform: scale(1.05);
  }
</style>