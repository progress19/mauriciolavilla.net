<style>
  .skeleton {
    background-size: 200% 100%;
    background-image: linear-gradient(
      110deg,
      #1414149c 25%,
      rgba(129, 129, 129, 0.1) 45%,
      #1414149c 65%
    );
    animation: shimmer 2s infinite linear;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .project-image {
    opacity: 0;
    transition: opacity 0.6s ease-in-out;
  }

  .project-image.loaded {
    opacity: 1;
  }
</style>

<script>
  function handleImages() {
    const images = document.querySelectorAll('.project-image');
    const skeletons = document.querySelectorAll('.skeleton');

    images.forEach((img, index) => {
      if (img instanceof HTMLImageElement) {
        // Calculamos un delay progresivo
        const delay = (index + 1) * 300; // 800ms por cada imagen

        setTimeout(() => {
          if (img.complete) {
            fadeInImage(img, skeletons[index]);
          } else {
            img.onload = () => fadeInImage(img, skeletons[index]);
          }
        }, delay);
      }
    });
  }

  function fadeInImage(img: HTMLImageElement, skeleton: Element | undefined) {
    // Esperamos un poco más después del delay inicial para una transición más suave
    setTimeout(() => {
      img.classList.add('loaded');
      skeleton?.classList.add('opacity-0');
      
      // Removemos el skeleton después de la transición
      setTimeout(() => {
        skeleton?.classList.add('hidden');
      }, 600);
    }, 200);
  }

  // Ejecutar cuando el DOM está listo
  document.addEventListener('astro:page-load', handleImages);
  // También ejecutar inmediatamente
  handleImages();
</script>
