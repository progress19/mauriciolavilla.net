<script>
  import { getTranslations } from '../translations.ts';

  // Función para aplicar traducciones a los proyectos
  function applyProjectsTranslations(language: string) {
    const translations = getTranslations(language);
    
    // Traducir elementos con data-translate
    document.querySelectorAll('[data-translate]').forEach(element => {
      const key = element.getAttribute('data-translate');
      if (key && key.startsWith('projects.')) {
        const translation = getNestedValue(translations, key);
        if (translation) {
          element.textContent = translation;
        }
      }
    });
  }

  // Función para obtener valores anidados de un objeto
  function getNestedValue(obj: any, path: string) {
    return path.split('.').reduce((current, key) => current?.[key], obj);
  }

  // Aplicar traducciones iniciales
  document.addEventListener('DOMContentLoaded', () => {
    const savedLanguage = localStorage.getItem('selectedLanguage') || 'es';
    applyProjectsTranslations(savedLanguage);

    // Asegurarse de que el skeleton se oculte cuando las imágenes se carguen
    const images = document.querySelectorAll('.project-image');
    images.forEach(img => {
      // Si la imagen ya está cargada (desde caché)
      if ((img as HTMLImageElement).complete) {
        const skeleton = img.parentElement?.querySelector('.skeleton');
        if (skeleton) skeleton.classList.add('hidden');
      }
      
      // Para imágenes que cargan después
      img.addEventListener('load', () => {
        const skeleton = img.parentElement?.querySelector('.skeleton');
        if (skeleton) skeleton.classList.add('hidden');
      });
    });
  });

  // Escuchar cambios de idioma
  window.addEventListener('languageChanged', (event: any) => {
    applyProjectsTranslations(event.detail.language);
  });
</script>